{
    "html": "<div class=\"hb-block hb-block-group hb-supports hb-flex-layout hb-ease-smooth\" data-block-name=\"heisenberg/group\" data-block-id=\"state-group\" style=\"--hb-border-top-style: solid; --hb-border-right-style: solid; --hb-border-bottom-style: solid; --hb-border-left-style: solid; --hb-flex-direction: column; --hb-anim-dur: 600; --hb-anim-delay: 0;\"><p class=\"hb-block hb-block-paragraph hb-supports hb-ease-smooth\" data-block-name=\"heisenberg/paragraph\" data-block-id=\"state-child\" style=\"--hb-paragraph-color: var(--ink); --hb-paragraph-bg: transparent; --hb-paragraph-fs: var(--fs-md); --hb-anim-dur: 600; --hb-anim-delay: 0;\"><span class=\"hb-block-paragraph__text\">Hover me</span></p></div><p class=\"hb-block hb-block-paragraph hb-supports hb-ease-smooth\" data-block-name=\"heisenberg/paragraph\" data-block-id=\"\" style=\"--hb-paragraph-color: var(--ink); --hb-paragraph-bg: transparent; --hb-paragraph-fs: var(--fs-md); --hb-anim-dur: 600; --hb-anim-delay: 0;\"><span class=\"hb-block-paragraph__text\">No styled state</span></p>",
    "css": "[data-block-id=\"state-group\"]:hover, [data-block-id=\"state-group\"].hb-state-preview-hover { --hb-group-w: 500px !important }\n[data-block-id=\"state-child\"]:hover, [data-block-id=\"state-child\"].hb-state-preview-hover { --hb-paragraph-color: #ff00ff !important }\n[data-block-id=\"state-child\"]:active, [data-block-id=\"state-child\"].hb-state-preview-active { --hb-paragraph-color: #00ff00 !important }\n[data-block-id=\"state-child\"]:focus-within, [data-block-id=\"state-child\"].hb-state-preview-focus { --hb-paragraph-color: #0000ff !important }"
}
