<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
         cacheDirectory=".phpunit.cache"
         failOnRisky="true"
         failOnWarning="true"
         defaultTestSuite="Heisenberg Test Suite">
    <testsuites>
        <testsuite name="Heisenberg Test Suite">
            <directory>tests</directory>
            <!-- Not a real test: a utility that dumps the rendered /editor page to disk for
                 the jsdom pipeline harness (tests/js/canvas-pipeline-harness.mjs,
                 tests/js/shortcode-parity.mjs). It always skips unless HB_DUMP_PATH is set, so
                 keeping it in the default suite just shows a permanent "skipped" in every run.
                 It lives in its own testsuite below, run explicitly by the JS harness tooling. -->
            <exclude>tests/Editor/DumpEditorHtmlTest.php</exclude>
        </testsuite>
        <!-- Invoked explicitly (never by a bare `phpunit`/`composer test` run; see
             defaultTestSuite above) via the phpunit "testsuite" CLI option, e.g.:
               HB_DUMP_PATH=/tmp/editor.html vendor/bin/phpunit
                 -\-testsuite "JS Harness Fixtures"
             (XML comments may not contain a literal double hyphen, hence the escaped
             flag above; drop the backslash when actually running the command). -->
        <testsuite name="JS Harness Fixtures">
            <file>tests/Editor/DumpEditorHtmlTest.php</file>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>src</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <!-- Default: in-memory SQLite, so `php vendor/bin/phpunit` passes on a
             fresh checkout with no external services (§4.16 remediation — this
             used to hard-pin MySQL, so BlockPersistenceTest errored in any
             environment without a local server). The posts/blocks schema is
             fully representable on SQLite (see TestCase::getEnvironmentSetUp()).
             A host CI that wants MySQL coverage (blueprint Rule 11, for the
             fuller future schema) copies this file to phpunit.xml (gitignored)
             and overrides these four envs; BlockPersistenceTest skips gracefully
             instead of erroring if that server isn't reachable. -->
        <env name="DB_CONNECTION" value="sqlite"/>
        <env name="DB_DATABASE" value=":memory:"/>
    </php>
</phpunit>
