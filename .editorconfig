root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{js,css,json,yml,yaml,blade.php}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.{woff2,png}]
insert_final_newline = false
trim_trailing_whitespace = false
