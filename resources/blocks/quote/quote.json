{
    "$schema": "../../../docs/block-schema.md",
    "apiVersion": 1,
    "name": "heisenberg/quote",
    "title": "heisenberg::blocks.quote.title",
    "category": "text",
    "icon": "quote",
    "description": "heisenberg::blocks.quote.description",
    "keywords": [
        "quote",
        "blockquote",
        "citation"
    ],
    "version": "1.0.0",
    "attributes": {
        "content": {
            "type": "rich-text",
            "default": "",
            "sanitize": "rich-text-block",
            "control": {
                "type": "textarea",
                "section": "settings"
            }
        },
        "citation": {
            "type": "rich-text",
            "default": "",
            "sanitize": "rich-text-inline",
            "control": {
                "type": "text",
                "section": "settings"
            }
        },
        "style": {
            "type": "string",
            "default": "default",
            "enum": [
                "default",
                "plain"
            ],
            "control": {
                "type": "select",
                "section": "settings"
            }
        },
        "anchor": {
            "type": "string",
            "default": "",
            "sanitize": "text",
            "control": {
                "type": "text",
                "section": "general",
                "half": true,
                "placeholder": "unique-id"
            }
        },
        "titleAttr": {
            "type": "string",
            "default": "",
            "sanitize": "text",
            "control": {
                "type": "text",
                "section": "general",
                "half": true,
                "placeholder": "Tooltip text"
            }
        },
        "extraClasses": {
            "type": "string",
            "default": "",
            "sanitize": "text",
            "control": {
                "type": "chips",
                "section": "general",
                "placeholder": "Add class…"
            }
        },
        "hideXs": {
            "type": "boolean",
            "default": false,
            "sanitize": "boolean",
            "control": {
                "type": "toggle",
                "section": "visibility",
                "half": true
            }
        },
        "hideSm": {
            "type": "boolean",
            "default": false,
            "sanitize": "boolean",
            "control": {
                "type": "toggle",
                "section": "visibility",
                "half": true
            }
        },
        "hideMd": {
            "type": "boolean",
            "default": false,
            "sanitize": "boolean",
            "control": {
                "type": "toggle",
                "section": "visibility",
                "half": true
            }
        },
        "hideLg": {
            "type": "boolean",
            "default": false,
            "sanitize": "boolean",
            "control": {
                "type": "toggle",
                "section": "visibility",
                "half": true
            }
        },
        "hideXl": {
            "type": "boolean",
            "default": false,
            "sanitize": "boolean",
            "control": {
                "type": "toggle",
                "section": "visibility",
                "half": true
            }
        },
        "hideXxl": {
            "type": "boolean",
            "default": false,
            "sanitize": "boolean",
            "control": {
                "type": "toggle",
                "section": "visibility",
                "half": true
            }
        },
        "fillWidth": {
            "type": "boolean",
            "default": false,
            "sanitize": "boolean",
            "control": false
        },
        "fillHeight": {
            "type": "boolean",
            "default": false,
            "sanitize": "boolean",
            "control": false
        },
        "hugWidth": {
            "type": "boolean",
            "default": false,
            "sanitize": "boolean",
            "control": false
        },
        "hugHeight": {
            "type": "boolean",
            "default": false,
            "sanitize": "boolean",
            "control": false
        },
        "clipContent": {
            "type": "boolean",
            "default": false,
            "sanitize": "boolean",
            "control": false
        }
    },
    "supports": {
        "color": {
            "text": true,
            "background": true,
            "custom": false
        },
        "typography": {
            "fontFamily": true,
            "fontWeight": true,
            "fontSize": true,
            "lineHeight": true,
            "textAlign": true,
            "letterSpacing": true
        },
        "size": {
            "width": true,
            "height": true,
            "minWidth": true,
            "minHeight": true,
            "maxWidth": true,
            "maxHeight": true
        },
        "spacing": {
            "margin": {
                "top": true,
                "right": true,
                "bottom": true,
                "left": true
            },
            "padding": {
                "top": true,
                "right": true,
                "bottom": true,
                "left": true
            }
        },
        "border": {
            "width": {
                "top": true,
                "right": true,
                "bottom": true,
                "left": true
            },
            "style": true,
            "color": true,
            "radius": {
                "topLeft": true,
                "topRight": true,
                "bottomRight": true,
                "bottomLeft": true
            }
        },
        "animation": true,
        "appearance": {
            "opacity": true
        },
        "states": {
            "hover": true,
            "active": true,
            "focus": true
        },
        "effects": {
            "shadow": true
        }
    },
    "style": {
        "css": "./quote.css",
        "className": "hb-block-quote hb-supports",
        "classNames": [
            {
                "class": "hb-quote--plain",
                "when": {
                    "attribute": "style",
                    "equals": "plain"
                }
            },
            {
                "class": "hb-hide-xs",
                "when": {
                    "attribute": "hideXs",
                    "equals": true
                }
            },
            {
                "class": "hb-hide-sm",
                "when": {
                    "attribute": "hideSm",
                    "equals": true
                }
            },
            {
                "class": "hb-hide-md",
                "when": {
                    "attribute": "hideMd",
                    "equals": true
                }
            },
            {
                "class": "hb-hide-lg",
                "when": {
                    "attribute": "hideLg",
                    "equals": true
                }
            },
            {
                "class": "hb-hide-xl",
                "when": {
                    "attribute": "hideXl",
                    "equals": true
                }
            },
            {
                "class": "hb-hide-xxl",
                "when": {
                    "attribute": "hideXxl",
                    "equals": true
                }
            },
            {
                "class": "hb-size-fill-w",
                "when": {
                    "attribute": "fillWidth",
                    "equals": true
                }
            },
            {
                "class": "hb-size-fill-h",
                "when": {
                    "attribute": "fillHeight",
                    "equals": true
                }
            },
            {
                "class": "hb-size-hug-w",
                "when": {
                    "attribute": "hugWidth",
                    "equals": true
                }
            },
            {
                "class": "hb-size-hug-h",
                "when": {
                    "attribute": "hugHeight",
                    "equals": true
                }
            },
            {
                "class": "hb-size-clip",
                "when": {
                    "attribute": "clipContent",
                    "equals": true
                }
            }
        ],
        "variables": {
            "--hb-quote-color": {
                "source": "supports.color.text",
                "default": "var(--ink)",
                "sanitize": "color-value"
            },
            "--hb-quote-bg": {
                "source": "supports.color.background",
                "default": "transparent",
                "sanitize": "color-value-or-gradient"
            },
            "--hb-quote-ff": {
                "source": "supports.typography.fontFamily",
                "default": "",
                "sanitize": "font-family"
            },
            "--hb-quote-fw": {
                "source": "supports.typography.fontWeight",
                "default": "",
                "sanitize": "font-weight"
            },
            "--hb-quote-fs": {
                "source": "supports.typography.fontSize",
                "default": "",
                "sanitize": "size-value"
            },
            "--hb-quote-lh": {
                "source": "supports.typography.lineHeight",
                "default": "",
                "sanitize": "size-token"
            },
            "--hb-quote-w": {
                "source": "supports.size.width",
                "default": "",
                "sanitize": "size-value"
            },
            "--hb-quote-h": {
                "source": "supports.size.height",
                "default": "",
                "sanitize": "size-value"
            },
            "--hb-quote-minw": {
                "source": "supports.size.minWidth",
                "default": "",
                "sanitize": "size-value"
            },
            "--hb-quote-minh": {
                "source": "supports.size.minHeight",
                "default": "",
                "sanitize": "size-value"
            },
            "--hb-quote-maxw": {
                "source": "supports.size.maxWidth",
                "default": "",
                "sanitize": "size-value"
            },
            "--hb-quote-maxh": {
                "source": "supports.size.maxHeight",
                "default": "",
                "sanitize": "size-value"
            },
            "--hb-quote-mt": {
                "source": "supports.spacing.margin.top",
                "default": "",
                "sanitize": "size-value"
            },
            "--hb-quote-mr": {
                "source": "supports.spacing.margin.right",
                "default": "",
                "sanitize": "size-value"
            },
            "--hb-quote-mb": {
                "source": "supports.spacing.margin.bottom",
                "default": "",
                "sanitize": "size-value"
            },
            "--hb-quote-ml": {
                "source": "supports.spacing.margin.left",
                "default": "",
                "sanitize": "size-value"
            },
            "--hb-quote-pt": {
                "source": "supports.spacing.padding.top",
                "default": "",
                "sanitize": "size-value"
            },
            "--hb-quote-pr": {
                "source": "supports.spacing.padding.right",
                "default": "",
                "sanitize": "size-value"
            },
            "--hb-quote-pb": {
                "source": "supports.spacing.padding.bottom",
                "default": "",
                "sanitize": "size-value"
            },
            "--hb-quote-pl": {
                "source": "supports.spacing.padding.left",
                "default": "",
                "sanitize": "size-value"
            },
            "--hb-border-top-width": {
                "source": "supports.border.width.top",
                "default": "",
                "sanitize": "size-value"
            },
            "--hb-border-right-width": {
                "source": "supports.border.width.right",
                "default": "",
                "sanitize": "size-value"
            },
            "--hb-border-bottom-width": {
                "source": "supports.border.width.bottom",
                "default": "",
                "sanitize": "size-value"
            },
            "--hb-border-left-width": {
                "source": "supports.border.width.left",
                "default": "",
                "sanitize": "size-value"
            },
            "--hb-border-top-style": {
                "source": "supports.border.style",
                "default": "solid",
                "sanitize": "border-style"
            },
            "--hb-border-right-style": {
                "source": "supports.border.style",
                "default": "solid",
                "sanitize": "border-style"
            },
            "--hb-border-bottom-style": {
                "source": "supports.border.style",
                "default": "solid",
                "sanitize": "border-style"
            },
            "--hb-border-left-style": {
                "source": "supports.border.style",
                "default": "solid",
                "sanitize": "border-style"
            },
            "--hb-border-top-color": {
                "source": "supports.border.color",
                "default": "",
                "sanitize": "color-value"
            },
            "--hb-border-right-color": {
                "source": "supports.border.color",
                "default": "",
                "sanitize": "color-value"
            },
            "--hb-border-bottom-color": {
                "source": "supports.border.color",
                "default": "",
                "sanitize": "color-value"
            },
            "--hb-border-left-color": {
                "source": "supports.border.color",
                "default": "",
                "sanitize": "color-value"
            },
            "--hb-border-radius-tl": {
                "source": "supports.border.radius.topLeft",
                "default": "",
                "sanitize": "size-value"
            },
            "--hb-border-radius-tr": {
                "source": "supports.border.radius.topRight",
                "default": "",
                "sanitize": "size-value"
            },
            "--hb-border-radius-br": {
                "source": "supports.border.radius.bottomRight",
                "default": "",
                "sanitize": "size-value"
            },
            "--hb-border-radius-bl": {
                "source": "supports.border.radius.bottomLeft",
                "default": "",
                "sanitize": "size-value"
            },
            "--hb-text-align": {
                "source": "supports.typography.textAlign",
                "default": "",
                "sanitize": "text-align"
            },
            "--hb-letter-spacing": {
                "source": "supports.typography.letterSpacing",
                "default": "",
                "sanitize": "length-signed"
            },
            "--hb-opacity": {
                "source": "supports.appearance.opacity",
                "default": "",
                "sanitize": "opacity"
            },
            "--hb-shadow": {
                "source": "supports.effects.shadow",
                "default": "",
                "sanitize": "shadow"
            }
        }
    },
    "render": {
        "template": {
            "tag": "blockquote",
            "class": "hb-block hb-block-quote {{attributes.extraClasses}}",
            "attributes": {
                "data-block-name": "{{name}}",
                "data-block-id": "{{id}}",
                "id": {
                    "value": "{{attributes.anchor}}",
                    "omitWhenEmpty": true
                },
                "title": {
                    "value": "{{attributes.titleAttr}}",
                    "omitWhenEmpty": true
                }
            },
            "children": [
                {
                    "tag": "p",
                    "class": "hb-block-quote__text",
                    "children": [
                        {
                            "type": "rich-text",
                            "attribute": "content"
                        }
                    ]
                },
                {
                    "tag": "cite",
                    "class": "hb-block-quote__cite",
                    "children": [
                        {
                            "type": "rich-text",
                            "attribute": "citation"
                        }
                    ]
                }
            ]
        },
        "publicPartial": "blocks.quote",
        "script": null
    },
    "email": {
        "template": {
            "tag": "table",
            "attributes": {
                "role": "presentation",
                "width": "100%",
                "cellpadding": "0",
                "cellspacing": "0",
                "border": "0"
            },
            "children": [
                {
                    "tag": "tr",
                    "children": [
                        {
                            "tag": "td",
                            "attributes": {
                                "style": "padding:0 0 16px 20px; border-left:4px solid var(--hb-quote-color, #0a0a0a);"
                            },
                            "children": [
                                {
                                    "tag": "p",
                                    "attributes": {
                                        "style": "margin:0 0 8px 0; font-family: var(--hb-quote-ff, Georgia, 'Times New Roman', serif); font-style:italic; font-size: var(--hb-quote-fs, 18px); line-height: var(--hb-quote-lh, 1.5); color: var(--hb-quote-color, #0a0a0a);"
                                    },
                                    "children": [
                                        {
                                            "type": "rich-text",
                                            "attribute": "content"
                                        }
                                    ]
                                },
                                {
                                    "tag": "p",
                                    "attributes": {
                                        "style": "margin:0; font-family: var(--hb-quote-ff, Arial, Helvetica, sans-serif); font-size:14px; color:#5a5a5a;"
                                    },
                                    "children": [
                                        {
                                            "type": "rich-text",
                                            "attribute": "citation"
                                        }
                                    ]
                                }
                            ]
                        }
                    ]
                }
            ]
        }
    },
    "innerBlocks": {
        "enabled": false
    },
    "serialization": {
        "mode": "json",
        "saveAttributes": true,
        "saveSupports": true,
        "saveInnerBlocks": true,
        "migrations": []
    },
    "security": {
        "richText": "inline-basic",
        "allowRawHtml": false,
        "allowCustomCss": false
    }
}
