{
    "$schema": "../../../docs/block-schema.md",
    "apiVersion": 1,
    "name": "heisenberg/button",
    "title": "heisenberg::blocks.button.title",
    "category": "design",
    "icon": "mouse-pointer-click",
    "description": "heisenberg::blocks.button.description",
    "keywords": [
        "button",
        "cta",
        "link",
        "action"
    ],
    "version": "1.0.0",
    "attributes": {
        "text": {
            "type": "rich-text",
            "default": "Click here",
            "sanitize": "rich-text-inline"
        },
        "url": {
            "type": "url",
            "default": "",
            "sanitize": "url",
            "control": {
                "type": "text",
                "section": "settings"
            }
        },
        "variant": {
            "type": "string",
            "default": "primary",
            "enum": [
                "primary",
                "secondary",
                "danger",
                "link",
                "outline"
            ],
            "control": {
                "type": "select",
                "section": "settings"
            }
        },
        "target": {
            "type": "string",
            "default": "_self",
            "enum": [
                "_self",
                "_blank"
            ],
            "control": {
                "type": "select",
                "section": "settings"
            }
        },
        "fullWidth": {
            "type": "boolean",
            "default": false,
            "sanitize": "boolean",
            "control": {
                "type": "toggle",
                "section": "settings"
            }
        },
        "anchor": {
            "type": "string",
            "default": "",
            "sanitize": "text",
            "control": {
                "type": "text",
                "section": "general",
                "half": true,
                "placeholder": "unique-id"
            }
        },
        "titleAttr": {
            "type": "string",
            "default": "",
            "sanitize": "text",
            "control": {
                "type": "text",
                "section": "general",
                "half": true,
                "placeholder": "Tooltip text"
            }
        },
        "extraClasses": {
            "type": "string",
            "default": "",
            "sanitize": "text",
            "control": {
                "type": "chips",
                "section": "general",
                "placeholder": "Add class…"
            }
        },
        "hideXs": {
            "type": "boolean",
            "default": false,
            "sanitize": "boolean",
            "control": {
                "type": "toggle",
                "section": "visibility",
                "half": true
            }
        },
        "hideSm": {
            "type": "boolean",
            "default": false,
            "sanitize": "boolean",
            "control": {
                "type": "toggle",
                "section": "visibility",
                "half": true
            }
        },
        "hideMd": {
            "type": "boolean",
            "default": false,
            "sanitize": "boolean",
            "control": {
                "type": "toggle",
                "section": "visibility",
                "half": true
            }
        },
        "hideLg": {
            "type": "boolean",
            "default": false,
            "sanitize": "boolean",
            "control": {
                "type": "toggle",
                "section": "visibility",
                "half": true
            }
        },
        "hideXl": {
            "type": "boolean",
            "default": false,
            "sanitize": "boolean",
            "control": {
                "type": "toggle",
                "section": "visibility",
                "half": true
            }
        },
        "hideXxl": {
            "type": "boolean",
            "default": false,
            "sanitize": "boolean",
            "control": {
                "type": "toggle",
                "section": "visibility",
                "half": true
            }
        },
        "fillWidth": {
            "type": "boolean",
            "default": false,
            "sanitize": "boolean",
            "control": false
        },
        "fillHeight": {
            "type": "boolean",
            "default": false,
            "sanitize": "boolean",
            "control": false
        },
        "hugWidth": {
            "type": "boolean",
            "default": false,
            "sanitize": "boolean",
            "control": false
        },
        "hugHeight": {
            "type": "boolean",
            "default": false,
            "sanitize": "boolean",
            "control": false
        },
        "clipContent": {
            "type": "boolean",
            "default": false,
            "sanitize": "boolean",
            "control": false
        }
    },
    "supports": {
        "align": ["left", "center", "right"],
        "color": {
            "text": true,
            "background": true,
            "custom": false
        },
        "typography": {
            "fontFamily": true,
            "fontWeight": true,
            "fontSize": true,
            "letterSpacing": true
        },
        "size": {
            "width": true,
            "height": true,
            "minWidth": true,
            "minHeight": true,
            "maxWidth": true,
            "maxHeight": true
        },
        "spacing": {
            "margin": {
                "top": true,
                "right": true,
                "bottom": true,
                "left": true
            },
            "padding": {
                "top": true,
                "right": true,
                "bottom": true,
                "left": true
            }
        },
        "border": {
            "width": {
                "top": true,
                "right": true,
                "bottom": true,
                "left": true
            },
            "style": true,
            "color": true,
            "radius": {
                "topLeft": true,
                "topRight": true,
                "bottomRight": true,
                "bottomLeft": true
            }
        },
        "animation": true,
        "appearance": {
            "opacity": true
        },
        "states": {
            "hover": true,
            "active": true,
            "focus": true
        },
        "effects": {
            "shadow": true
        }
    },
    "style": {
        "css": "./button.css",
        "className": "hb-block-button hb-supports",
        "classNames": [
            {
                "class": "hb-hide-xs",
                "when": {
                    "attribute": "hideXs",
                    "equals": true
                }
            },
            {
                "class": "hb-hide-sm",
                "when": {
                    "attribute": "hideSm",
                    "equals": true
                }
            },
            {
                "class": "hb-hide-md",
                "when": {
                    "attribute": "hideMd",
                    "equals": true
                }
            },
            {
                "class": "hb-hide-lg",
                "when": {
                    "attribute": "hideLg",
                    "equals": true
                }
            },
            {
                "class": "hb-hide-xl",
                "when": {
                    "attribute": "hideXl",
                    "equals": true
                }
            },
            {
                "class": "hb-hide-xxl",
                "when": {
                    "attribute": "hideXxl",
                    "equals": true
                }
            },
            {
                "class": "hb-size-fill-w",
                "when": {
                    "attribute": "fillWidth",
                    "equals": true
                }
            },
            {
                "class": "hb-size-fill-h",
                "when": {
                    "attribute": "fillHeight",
                    "equals": true
                }
            },
            {
                "class": "hb-size-hug-w",
                "when": {
                    "attribute": "hugWidth",
                    "equals": true
                }
            },
            {
                "class": "hb-size-hug-h",
                "when": {
                    "attribute": "hugHeight",
                    "equals": true
                }
            },
            {
                "class": "hb-size-clip",
                "when": {
                    "attribute": "clipContent",
                    "equals": true
                }
            },
            {
                "class": "hb-btn--primary",
                "when": {
                    "attribute": "variant",
                    "equals": "primary"
                }
            },
            {
                "class": "hb-btn--secondary",
                "when": {
                    "attribute": "variant",
                    "equals": "secondary"
                }
            },
            {
                "class": "hb-btn--danger",
                "when": {
                    "attribute": "variant",
                    "equals": "danger"
                }
            },
            {
                "class": "hb-btn--link",
                "when": {
                    "attribute": "variant",
                    "equals": "link"
                }
            },
            {
                "class": "hb-btn--outline",
                "when": {
                    "attribute": "variant",
                    "equals": "outline"
                }
            },
            {
                "class": "hb-btn--full",
                "when": {
                    "attribute": "fullWidth",
                    "equals": true
                }
            }
        ],
        "variables": {
            "--hb-button-color": {
                "source": "supports.color.text",
                "default": "",
                "sanitize": "color-value"
            },
            "--hb-button-bg": {
                "source": "supports.color.background",
                "default": "",
                "sanitize": "color-value-or-gradient"
            },
            "--hb-button-ff": {
                "source": "supports.typography.fontFamily",
                "default": "",
                "sanitize": "font-family"
            },
            "--hb-button-fw": {
                "source": "supports.typography.fontWeight",
                "default": "",
                "sanitize": "font-weight"
            },
            "--hb-button-fs": {
                "source": "supports.typography.fontSize",
                "default": "",
                "sanitize": "size-value"
            },
            "--hb-button-w": {
                "source": "supports.size.width",
                "default": "",
                "sanitize": "size-value"
            },
            "--hb-button-h": {
                "source": "supports.size.height",
                "default": "",
                "sanitize": "size-value"
            },
            "--hb-button-minw": {
                "source": "supports.size.minWidth",
                "default": "",
                "sanitize": "size-value"
            },
            "--hb-button-minh": {
                "source": "supports.size.minHeight",
                "default": "",
                "sanitize": "size-value"
            },
            "--hb-button-maxw": {
                "source": "supports.size.maxWidth",
                "default": "",
                "sanitize": "size-value"
            },
            "--hb-button-maxh": {
                "source": "supports.size.maxHeight",
                "default": "",
                "sanitize": "size-value"
            },
            "--hb-button-mt": {
                "source": "supports.spacing.margin.top",
                "default": "",
                "sanitize": "size-value"
            },
            "--hb-button-mr": {
                "source": "supports.spacing.margin.right",
                "default": "",
                "sanitize": "size-value"
            },
            "--hb-button-mb": {
                "source": "supports.spacing.margin.bottom",
                "default": "",
                "sanitize": "size-value"
            },
            "--hb-button-ml": {
                "source": "supports.spacing.margin.left",
                "default": "",
                "sanitize": "size-value"
            },
            "--hb-button-pt": {
                "source": "supports.spacing.padding.top",
                "default": "",
                "sanitize": "size-value"
            },
            "--hb-button-pr": {
                "source": "supports.spacing.padding.right",
                "default": "",
                "sanitize": "size-value"
            },
            "--hb-button-pb": {
                "source": "supports.spacing.padding.bottom",
                "default": "",
                "sanitize": "size-value"
            },
            "--hb-button-pl": {
                "source": "supports.spacing.padding.left",
                "default": "",
                "sanitize": "size-value"
            },
            "--hb-border-top-width": {
                "source": "supports.border.width.top",
                "default": "",
                "sanitize": "size-value"
            },
            "--hb-border-right-width": {
                "source": "supports.border.width.right",
                "default": "",
                "sanitize": "size-value"
            },
            "--hb-border-bottom-width": {
                "source": "supports.border.width.bottom",
                "default": "",
                "sanitize": "size-value"
            },
            "--hb-border-left-width": {
                "source": "supports.border.width.left",
                "default": "",
                "sanitize": "size-value"
            },
            "--hb-border-top-style": {
                "source": "supports.border.style",
                "default": "solid",
                "sanitize": "border-style"
            },
            "--hb-border-right-style": {
                "source": "supports.border.style",
                "default": "solid",
                "sanitize": "border-style"
            },
            "--hb-border-bottom-style": {
                "source": "supports.border.style",
                "default": "solid",
                "sanitize": "border-style"
            },
            "--hb-border-left-style": {
                "source": "supports.border.style",
                "default": "solid",
                "sanitize": "border-style"
            },
            "--hb-border-top-color": {
                "source": "supports.border.color",
                "default": "",
                "sanitize": "color-value"
            },
            "--hb-border-right-color": {
                "source": "supports.border.color",
                "default": "",
                "sanitize": "color-value"
            },
            "--hb-border-bottom-color": {
                "source": "supports.border.color",
                "default": "",
                "sanitize": "color-value"
            },
            "--hb-border-left-color": {
                "source": "supports.border.color",
                "default": "",
                "sanitize": "color-value"
            },
            "--hb-border-radius-tl": {
                "source": "supports.border.radius.topLeft",
                "default": "",
                "sanitize": "size-value"
            },
            "--hb-border-radius-tr": {
                "source": "supports.border.radius.topRight",
                "default": "",
                "sanitize": "size-value"
            },
            "--hb-border-radius-br": {
                "source": "supports.border.radius.bottomRight",
                "default": "",
                "sanitize": "size-value"
            },
            "--hb-border-radius-bl": {
                "source": "supports.border.radius.bottomLeft",
                "default": "",
                "sanitize": "size-value"
            },
            "--hb-letter-spacing": {
                "source": "supports.typography.letterSpacing",
                "default": "",
                "sanitize": "length-signed"
            },
            "--hb-opacity": {
                "source": "supports.appearance.opacity",
                "default": "",
                "sanitize": "opacity"
            },
            "--hb-shadow": {
                "source": "supports.effects.shadow",
                "default": "",
                "sanitize": "shadow"
            }
        }
    },
    "render": {
        "template": {
            "tag": "a",
            "class": "hb-block hb-block-button {{attributes.extraClasses}}",
            "attributes": {
                "data-block-name": "{{name}}",
                "data-block-id": "{{id}}",
                "href": {
                    "value": "{{attributes.url}}",
                    "omitWhenEmpty": true
                },
                "target": {
                    "value": "{{attributes.target}}",
                    "omitWhenEmpty": true
                },
                "id": {
                    "value": "{{attributes.anchor}}",
                    "omitWhenEmpty": true
                },
                "title": {
                    "value": "{{attributes.titleAttr}}",
                    "omitWhenEmpty": true
                }
            },
            "children": [
                {
                    "type": "rich-text",
                    "attribute": "text",
                    "class": "hb-block-button__label"
                }
            ]
        },
        "publicPartial": "blocks.button",
        "script": null
    },
    "email": {
        "template": {
            "tag": "table",
            "attributes": {
                "role": "presentation",
                "width": "100%",
                "cellpadding": "0",
                "cellspacing": "0",
                "border": "0"
            },
            "children": [
                {
                    "tag": "tr",
                    "children": [
                        {
                            "tag": "td",
                            "attributes": {
                                "align": "left",
                                "style": "padding:0 0 16px 0;"
                            },
                            "children": [
                                {
                                    "tag": "table",
                                    "attributes": {
                                        "role": "presentation",
                                        "cellpadding": "0",
                                        "cellspacing": "0",
                                        "border": "0"
                                    },
                                    "children": [
                                        {
                                            "tag": "tr",
                                            "children": [
                                                {
                                                    "tag": "td",
                                                    "attributes": {
                                                        "align": "center",
                                                        "style": "border-radius:4px; background-color: var(--hb-button-bg, #0a0a0a);"
                                                    },
                                                    "children": [
                                                        {
                                                            "tag": "a",
                                                            "attributes": {
                                                                "href": {
                                                                    "value": "{{attributes.url}}",
                                                                    "omitWhenEmpty": true
                                                                },
                                                                "style": "display:inline-block; padding:12px 24px; font-family: var(--hb-button-ff, Arial, Helvetica, sans-serif); font-weight: var(--hb-button-fw, 600); font-size: var(--hb-button-fs, 15px); color: var(--hb-button-color, #ffffff); text-decoration:none; border-radius:4px;"
                                                            },
                                                            "children": [
                                                                {
                                                                    "type": "rich-text",
                                                                    "attribute": "text"
                                                                }
                                                            ]
                                                        }
                                                    ]
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        }
                    ]
                }
            ]
        }
    },
    "innerBlocks": {
        "enabled": false
    },
    "serialization": {
        "mode": "json",
        "saveAttributes": true,
        "saveSupports": true,
        "saveInnerBlocks": true,
        "migrations": []
    },
    "security": {
        "richText": "inline-basic",
        "allowRawHtml": false,
        "allowCustomCss": false
    }
}
