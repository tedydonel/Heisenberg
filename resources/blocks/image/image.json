{
    "$schema": "../../../docs/block-schema.md",
    "apiVersion": 1,
    "name": "heisenberg/image",
    "title": "heisenberg::blocks.image.title",
    "category": "media",
    "icon": "image",
    "description": "heisenberg::blocks.image.description",
    "keywords": [
        "image",
        "photo",
        "media",
        "picture"
    ],
    "version": "1.0.0",
    "attributes": {
        "url": {
            "type": "url",
            "default": "",
            "sanitize": "url",
            "control": {
                "type": "media",
                "section": "settings",
                "placeholder": "https://…"
            }
        },
        "alt": {
            "type": "string",
            "default": "",
            "sanitize": "text",
            "translatable": true,
            "control": {
                "type": "text",
                "section": "settings"
            }
        },
        "caption": {
            "type": "rich-text",
            "default": "",
            "sanitize": "rich-text-inline",
            "translatable": true,
            "control": {
                "type": "textarea",
                "section": "settings"
            }
        },
        "href": {
            "type": "url",
            "default": "",
            "sanitize": "url",
            "control": {
                "type": "text",
                "section": "settings"
            }
        },
        "target": {
            "type": "string",
            "default": "_self",
            "sanitize": "text",
            "enum": [
                "_self",
                "_blank"
            ],
            "control": {
                "type": "select",
                "section": "settings"
            }
        },
        "aspectRatio": {
            "type": "string",
            "default": "",
            "sanitize": "text",
            "enum": [
                "",
                "1/1",
                "4/3",
                "3/2",
                "16/9",
                "21/9"
            ],
            "control": {
                "type": "select",
                "section": "settings"
            }
        },
        "scale": {
            "type": "string",
            "default": "cover",
            "sanitize": "text",
            "enum": [
                "cover",
                "contain",
                "fill"
            ],
            "control": {
                "type": "select",
                "section": "settings"
            }
        },
        "lightboxEnabled": {
            "type": "boolean",
            "default": false,
            "sanitize": "boolean",
            "control": false
        },
        "anchor": {
            "type": "string",
            "default": "",
            "sanitize": "text",
            "control": {
                "type": "text",
                "section": "general",
                "half": true,
                "placeholder": "unique-id"
            }
        },
        "titleAttr": {
            "type": "string",
            "default": "",
            "sanitize": "text",
            "translatable": true,
            "control": {
                "type": "text",
                "section": "general",
                "half": true,
                "placeholder": "Tooltip text"
            }
        },
        "extraClasses": {
            "type": "string",
            "default": "",
            "sanitize": "text",
            "control": {
                "type": "chips",
                "section": "general",
                "placeholder": "Add class…"
            }
        },
        "hideMobile": {
            "type": "boolean",
            "default": false,
            "sanitize": "boolean",
            "control": {
                "type": "toggle",
                "section": "visibility",
                "half": true
            }
        },
        "hideTablet": {
            "type": "boolean",
            "default": false,
            "sanitize": "boolean",
            "control": {
                "type": "toggle",
                "section": "visibility",
                "half": true
            }
        },
        "hideDesktop": {
            "type": "boolean",
            "default": false,
            "sanitize": "boolean",
            "control": {
                "type": "toggle",
                "section": "visibility",
                "half": true
            }
        },
        "fillWidth": {
            "type": "boolean",
            "default": false,
            "sanitize": "boolean",
            "control": false
        },
        "fillHeight": {
            "type": "boolean",
            "default": false,
            "sanitize": "boolean",
            "control": false
        },
        "hugWidth": {
            "type": "boolean",
            "default": false,
            "sanitize": "boolean",
            "control": false
        },
        "hugHeight": {
            "type": "boolean",
            "default": false,
            "sanitize": "boolean",
            "control": false
        },
        "clipContent": {
            "type": "boolean",
            "default": false,
            "sanitize": "boolean",
            "control": false
        }
    },
    "supports": {
        "align": [
            "left",
            "center",
            "right"
        ],
        "color": {
            "background": true,
            "custom": false
        },
        "size": {
            "width": true,
            "height": true,
            "minWidth": true,
            "minHeight": true,
            "maxWidth": true,
            "maxHeight": true
        },
        "spacing": {
            "margin": {
                "top": true,
                "right": true,
                "bottom": true,
                "left": true
            },
            "padding": {
                "top": true,
                "right": true,
                "bottom": true,
                "left": true
            }
        },
        "border": {
            "width": {
                "top": true,
                "right": true,
                "bottom": true,
                "left": true
            },
            "style": true,
            "color": true,
            "radius": {
                "topLeft": true,
                "topRight": true,
                "bottomRight": true,
                "bottomLeft": true
            },
            "position": true
        },
        "animation": true,
        "appearance": {
            "opacity": true
        },
        "states": {
            "hover": true,
            "active": true,
            "focus": true
        },
        "position": {
            "x": true,
            "y": true,
            "rotation": true,
            "mode": true
        },
        "effects": {
            "shadow": true,
            "filter": true,
            "backdrop": true
        }
    },
    "style": {
        "css": "./image.css",
        "className": "hb-block-image hb-supports",
        "classNames": [
            {
                "class": "hb-hide-mobile",
                "when": {
                    "attribute": "hideMobile",
                    "equals": true
                }
            },
            {
                "class": "hb-hide-tablet",
                "when": {
                    "attribute": "hideTablet",
                    "equals": true
                }
            },
            {
                "class": "hb-hide-desktop",
                "when": {
                    "attribute": "hideDesktop",
                    "equals": true
                }
            },
            {
                "class": "hb-size-fill-w",
                "when": {
                    "attribute": "fillWidth",
                    "equals": true
                }
            },
            {
                "class": "hb-size-fill-h",
                "when": {
                    "attribute": "fillHeight",
                    "equals": true
                }
            },
            {
                "class": "hb-size-hug-w",
                "when": {
                    "attribute": "hugWidth",
                    "equals": true
                }
            },
            {
                "class": "hb-size-hug-h",
                "when": {
                    "attribute": "hugHeight",
                    "equals": true
                }
            },
            {
                "class": "hb-size-clip",
                "when": {
                    "attribute": "clipContent",
                    "equals": true
                }
            }
        ],
        "variables": {
            "--hb-image-bg": {
                "source": "supports.color.background",
                "default": "",
                "sanitize": "color-value-or-gradient"
            },
            "--hb-image-w": {
                "source": "supports.size.width",
                "default": "",
                "sanitize": "size-value"
            },
            "--hb-image-h": {
                "source": "supports.size.height",
                "default": "",
                "sanitize": "size-value"
            },
            "--hb-image-minw": {
                "source": "supports.size.minWidth",
                "default": "",
                "sanitize": "size-value"
            },
            "--hb-image-minh": {
                "source": "supports.size.minHeight",
                "default": "",
                "sanitize": "size-value"
            },
            "--hb-image-maxw": {
                "source": "supports.size.maxWidth",
                "default": "",
                "sanitize": "size-value"
            },
            "--hb-image-maxh": {
                "source": "supports.size.maxHeight",
                "default": "",
                "sanitize": "size-value"
            },
            "--hb-image-mt": {
                "source": "supports.spacing.margin.top",
                "default": "",
                "sanitize": "size-value"
            },
            "--hb-image-mr": {
                "source": "supports.spacing.margin.right",
                "default": "",
                "sanitize": "size-value"
            },
            "--hb-image-mb": {
                "source": "supports.spacing.margin.bottom",
                "default": "",
                "sanitize": "size-value"
            },
            "--hb-image-ml": {
                "source": "supports.spacing.margin.left",
                "default": "",
                "sanitize": "size-value"
            },
            "--hb-image-pt": {
                "source": "supports.spacing.padding.top",
                "default": "",
                "sanitize": "size-value"
            },
            "--hb-image-pr": {
                "source": "supports.spacing.padding.right",
                "default": "",
                "sanitize": "size-value"
            },
            "--hb-image-pb": {
                "source": "supports.spacing.padding.bottom",
                "default": "",
                "sanitize": "size-value"
            },
            "--hb-image-pl": {
                "source": "supports.spacing.padding.left",
                "default": "",
                "sanitize": "size-value"
            },
            "--hb-image-ratio": {
                "source": "attributes.aspectRatio",
                "default": "",
                "sanitize": "text"
            },
            "--hb-image-fit": {
                "source": "attributes.scale",
                "default": "cover",
                "sanitize": "text"
            },
            "--hb-border-top-width": {
                "source": "supports.border.width.top",
                "default": "",
                "sanitize": "size-value"
            },
            "--hb-border-right-width": {
                "source": "supports.border.width.right",
                "default": "",
                "sanitize": "size-value"
            },
            "--hb-border-bottom-width": {
                "source": "supports.border.width.bottom",
                "default": "",
                "sanitize": "size-value"
            },
            "--hb-border-left-width": {
                "source": "supports.border.width.left",
                "default": "",
                "sanitize": "size-value"
            },
            "--hb-border-top-style": {
                "source": "supports.border.style",
                "default": "solid",
                "sanitize": "border-style"
            },
            "--hb-border-right-style": {
                "source": "supports.border.style",
                "default": "solid",
                "sanitize": "border-style"
            },
            "--hb-border-bottom-style": {
                "source": "supports.border.style",
                "default": "solid",
                "sanitize": "border-style"
            },
            "--hb-border-left-style": {
                "source": "supports.border.style",
                "default": "solid",
                "sanitize": "border-style"
            },
            "--hb-border-top-color": {
                "source": "supports.border.color",
                "default": "",
                "sanitize": "color-value"
            },
            "--hb-border-right-color": {
                "source": "supports.border.color",
                "default": "",
                "sanitize": "color-value"
            },
            "--hb-border-bottom-color": {
                "source": "supports.border.color",
                "default": "",
                "sanitize": "color-value"
            },
            "--hb-border-left-color": {
                "source": "supports.border.color",
                "default": "",
                "sanitize": "color-value"
            },
            "--hb-border-radius-tl": {
                "source": "supports.border.radius.topLeft",
                "default": "",
                "sanitize": "size-value"
            },
            "--hb-border-radius-tr": {
                "source": "supports.border.radius.topRight",
                "default": "",
                "sanitize": "size-value"
            },
            "--hb-border-radius-br": {
                "source": "supports.border.radius.bottomRight",
                "default": "",
                "sanitize": "size-value"
            },
            "--hb-border-radius-bl": {
                "source": "supports.border.radius.bottomLeft",
                "default": "",
                "sanitize": "size-value"
            },
            "--hb-opacity": {
                "source": "supports.appearance.opacity",
                "default": "",
                "sanitize": "opacity"
            },
            "--hb-tx": {
                "source": "supports.position.x",
                "default": "",
                "sanitize": "length-signed"
            },
            "--hb-ty": {
                "source": "supports.position.y",
                "default": "",
                "sanitize": "length-signed"
            },
            "--hb-rotate": {
                "source": "supports.position.rotation",
                "default": "",
                "sanitize": "angle"
            },
            "--hb-shadow": {
                "source": "supports.effects.shadow",
                "default": "",
                "sanitize": "shadow"
            },
            "--hb-position-mode": {
                "source": "supports.position.mode",
                "default": "",
                "sanitize": "position-mode"
            },
            "--hb-box-sizing": {
                "source": "supports.border.position",
                "default": "",
                "sanitize": "box-sizing"
            },
            "--hb-filter": {
                "source": "supports.effects.filter",
                "default": "",
                "sanitize": "filter"
            },
            "--hb-backdrop": {
                "source": "supports.effects.backdrop",
                "default": "",
                "sanitize": "filter"
            }
        }
    },
    "render": {
        "template": {
            "tag": "figure",
            "class": "hb-block hb-block-image {{attributes.extraClasses}}",
            "attributes": {
                "data-block-name": "{{name}}",
                "data-block-id": "{{id}}",
                "id": {
                    "value": "{{attributes.anchor}}",
                    "omitWhenEmpty": true
                },
                "title": {
                    "value": "{{attributes.titleAttr}}",
                    "omitWhenEmpty": true
                },
                "data-hb-lightbox": {
                    "boolean": "{{attributes.lightboxEnabled}}"
                }
            },
            "children": [
                {
                    "tag": "a",
                    "attributes": {
                        "href": {
                            "value": "{{attributes.href}}",
                            "omitWhenEmpty": true
                        },
                        "target": {
                            "value": "{{attributes.target}}",
                            "omitWhenEmpty": true
                        }
                    },
                    "children": [
                        {
                            "tag": "img",
                            "class": "hb-block-image__img",
                            "attributes": {
                                "src": "{{attributes.url}}",
                                "alt": "{{attributes.alt}}",
                                "loading": "lazy",
                                "decoding": "async"
                            }
                        }
                    ]
                },
                {
                    "tag": "figcaption",
                    "class": "hb-block-image__caption",
                    "children": [
                        {
                            "type": "rich-text",
                            "attribute": "caption"
                        }
                    ]
                }
            ]
        },
        "publicPartial": "blocks.image",
        "script": null
    },
    "email": {
        "template": {
            "tag": "table",
            "attributes": {
                "role": "presentation",
                "cellpadding": "0",
                "cellspacing": "0",
                "border": "0",
                "width": "100%"
            },
            "children": [
                {
                    "tag": "tr",
                    "children": [
                        {
                            "tag": "td",
                            "attributes": {
                                "align": {
                                    "enumMap": "{{supports.align}}",
                                    "cases": {
                                        "left": "left",
                                        "center": "center",
                                        "right": "right"
                                    },
                                    "default": "center"
                                },
                                "style": {
                                    "enumMap": "{{attributes._emailNested}}",
                                    "cases": {
                                        "1": "padding: var(--hb-image-mt, 0) var(--hb-image-mr, 0) var(--hb-image-mb, 0) var(--hb-image-ml, 0);"
                                    },
                                    "default": "padding: var(--hb-image-mt, 0) var(--hb-image-mr, 0) var(--hb-image-mb, 16px) var(--hb-image-ml, 0);"
                                }
                            },
                            "children": [
                                {
                                    "tag": "a",
                                    "omitTagWhenAttributeEmpty": "href",
                                    "attributes": {
                                        "href": {
                                            "value": "{{attributes.href}}",
                                            "omitWhenEmpty": true
                                        }
                                    },
                                    "children": [
                                        {
                                            "tag": "img",
                                            "attributes": {
                                                "src": "{{attributes.url}}",
                                                "alt": "{{attributes.alt}}",
                                                "width": "600",
                                                "style": "display:block; width: var(--hb-image-w, 100%); max-width: var(--hb-image-maxw, 600px); height: var(--hb-image-h, auto); border-top: var(--hb-border-top-width, 0) var(--hb-border-top-style, solid) var(--hb-border-top-color, transparent); border-right: var(--hb-border-right-width, 0) var(--hb-border-right-style, solid) var(--hb-border-right-color, transparent); border-bottom: var(--hb-border-bottom-width, 0) var(--hb-border-bottom-style, solid) var(--hb-border-bottom-color, transparent); border-left: var(--hb-border-left-width, 0) var(--hb-border-left-style, solid) var(--hb-border-left-color, transparent); border-radius: var(--hb-border-radius-tl, 0) var(--hb-border-radius-tr, 0) var(--hb-border-radius-br, 0) var(--hb-border-radius-bl, 0);"
                                            }
                                        }
                                    ]
                                },
                                {
                                    "tag": "div",
                                    "attributes": {
                                        "style": "margin-top:8px; font-family: var(--hb-t-font-base, Arial, Helvetica, sans-serif); font-size:13px; color:#5a5a5a;"
                                    },
                                    "children": [
                                        {
                                            "type": "rich-text",
                                            "attribute": "caption"
                                        }
                                    ]
                                }
                            ]
                        }
                    ]
                }
            ]
        }
    },
    "innerBlocks": {
        "enabled": false
    },
    "serialization": {
        "mode": "json",
        "saveAttributes": true,
        "saveSupports": true,
        "saveInnerBlocks": true,
        "migrations": []
    },
    "security": {
        "richText": "inline-basic",
        "allowRawHtml": false,
        "allowCustomCss": false
    }
}
