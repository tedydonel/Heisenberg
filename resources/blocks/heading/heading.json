{
    "$schema": "../../../docs/block-schema.md",
    "apiVersion": 1,
    "name": "heisenberg/heading",
    "title": "heisenberg::blocks.heading.title",
    "category": "text",
    "icon": "bookmark",
    "description": "heisenberg::blocks.heading.description",
    "keywords": [
        "heading",
        "title",
        "text"
    ],
    "version": "1.0.0",
    "attributes": {
        "content": {
            "type": "rich-text",
            "default": "",
            "sanitize": "rich-text-inline",
            "translatable": true,
            "control": {
                "type": "textarea",
                "section": "settings"
            }
        },
        "level": {
            "type": "integer",
            "default": 2,
            "enum": [
                1,
                2,
                3,
                4,
                5,
                6
            ],
            "control": {
                "type": "select",
                "section": "settings",
                "inline": true,
                "options": [
                    {
                        "value": 1,
                        "label": "H1"
                    },
                    {
                        "value": 2,
                        "label": "H2"
                    },
                    {
                        "value": 3,
                        "label": "H3"
                    },
                    {
                        "value": 4,
                        "label": "H4"
                    },
                    {
                        "value": 5,
                        "label": "H5"
                    },
                    {
                        "value": 6,
                        "label": "H6"
                    }
                ]
            }
        },
        "anchor": {
            "type": "string",
            "default": "",
            "sanitize": "text",
            "control": {
                "type": "text",
                "section": "general",
                "half": true,
                "placeholder": "unique-id"
            }
        },
        "titleAttr": {
            "type": "string",
            "default": "",
            "sanitize": "text",
            "translatable": true,
            "control": {
                "type": "text",
                "section": "general",
                "half": true,
                "placeholder": "Tooltip text"
            }
        },
        "extraClasses": {
            "type": "string",
            "default": "",
            "sanitize": "text",
            "control": {
                "type": "chips",
                "section": "general",
                "placeholder": "Add class…"
            }
        },
        "hideMobile": {
            "type": "boolean",
            "default": false,
            "sanitize": "boolean",
            "control": {
                "type": "toggle",
                "section": "visibility",
                "half": true
            }
        },
        "hideTablet": {
            "type": "boolean",
            "default": false,
            "sanitize": "boolean",
            "control": {
                "type": "toggle",
                "section": "visibility",
                "half": true
            }
        },
        "hideDesktop": {
            "type": "boolean",
            "default": false,
            "sanitize": "boolean",
            "control": {
                "type": "toggle",
                "section": "visibility",
                "half": true
            }
        },
        "fillWidth": {
            "type": "boolean",
            "default": false,
            "sanitize": "boolean",
            "control": false
        },
        "fillHeight": {
            "type": "boolean",
            "default": false,
            "sanitize": "boolean",
            "control": false
        },
        "hugWidth": {
            "type": "boolean",
            "default": false,
            "sanitize": "boolean",
            "control": false
        },
        "hugHeight": {
            "type": "boolean",
            "default": false,
            "sanitize": "boolean",
            "control": false
        },
        "clipContent": {
            "type": "boolean",
            "default": false,
            "sanitize": "boolean",
            "control": false
        }
    },
    "supports": {
        "color": {
            "text": true,
            "background": true,
            "custom": false
        },
        "typography": {
            "fontFamily": true,
            "fontWeight": true,
            "fontSize": true,
            "lineHeight": true,
            "textAlign": true,
            "textAlignVertical": true,
            "letterSpacing": true
        },
        "size": {
            "width": true,
            "height": true,
            "minWidth": true,
            "minHeight": true,
            "maxWidth": true,
            "maxHeight": true
        },
        "spacing": {
            "margin": {
                "top": true,
                "right": true,
                "bottom": true,
                "left": true
            },
            "padding": {
                "top": true,
                "right": true,
                "bottom": true,
                "left": true
            }
        },
        "animation": true,
        "appearance": {
            "opacity": true
        },
        "states": {
            "hover": true,
            "active": true,
            "focus": true
        },
        "position": {
            "x": true,
            "y": true,
            "rotation": true,
            "mode": true
        },
        "effects": {
            "shadow": true
        }
    },
    "style": {
        "css": "./heading.css",
        "className": "hb-block-heading hb-supports",
        "classNames": [
            {
                "class": "hb-hide-mobile",
                "when": {
                    "attribute": "hideMobile",
                    "equals": true
                }
            },
            {
                "class": "hb-hide-tablet",
                "when": {
                    "attribute": "hideTablet",
                    "equals": true
                }
            },
            {
                "class": "hb-hide-desktop",
                "when": {
                    "attribute": "hideDesktop",
                    "equals": true
                }
            },
            {
                "class": "hb-size-fill-w",
                "when": {
                    "attribute": "fillWidth",
                    "equals": true
                }
            },
            {
                "class": "hb-size-fill-h",
                "when": {
                    "attribute": "fillHeight",
                    "equals": true
                }
            },
            {
                "class": "hb-size-hug-w",
                "when": {
                    "attribute": "hugWidth",
                    "equals": true
                }
            },
            {
                "class": "hb-size-hug-h",
                "when": {
                    "attribute": "hugHeight",
                    "equals": true
                }
            },
            {
                "class": "hb-size-clip",
                "when": {
                    "attribute": "clipContent",
                    "equals": true
                }
            }
        ],
        "variables": {
            "--hb-heading-color": {
                "source": "supports.color.text",
                "default": "var(--ink)",
                "sanitize": "color-value"
            },
            "--hb-heading-bg": {
                "source": "supports.color.background",
                "default": "transparent",
                "sanitize": "color-value-or-gradient"
            },
            "--hb-heading-ff": {
                "source": "supports.typography.fontFamily",
                "default": "",
                "sanitize": "font-family"
            },
            "--hb-heading-fw": {
                "source": "supports.typography.fontWeight",
                "default": "",
                "sanitize": "font-weight"
            },
            "--hb-heading-fs": {
                "source": "supports.typography.fontSize",
                "default": "",
                "sanitize": "size-value"
            },
            "--hb-heading-w": {
                "source": "supports.size.width",
                "default": "",
                "sanitize": "size-value"
            },
            "--hb-heading-h": {
                "source": "supports.size.height",
                "default": "",
                "sanitize": "size-value"
            },
            "--hb-heading-minw": {
                "source": "supports.size.minWidth",
                "default": "",
                "sanitize": "size-value"
            },
            "--hb-heading-minh": {
                "source": "supports.size.minHeight",
                "default": "",
                "sanitize": "size-value"
            },
            "--hb-heading-maxw": {
                "source": "supports.size.maxWidth",
                "default": "",
                "sanitize": "size-value"
            },
            "--hb-heading-maxh": {
                "source": "supports.size.maxHeight",
                "default": "",
                "sanitize": "size-value"
            },
            "--hb-heading-mt": {
                "source": "supports.spacing.margin.top",
                "default": "",
                "sanitize": "size-value"
            },
            "--hb-heading-mr": {
                "source": "supports.spacing.margin.right",
                "default": "",
                "sanitize": "size-value"
            },
            "--hb-heading-mb": {
                "source": "supports.spacing.margin.bottom",
                "default": "",
                "sanitize": "size-value"
            },
            "--hb-heading-ml": {
                "source": "supports.spacing.margin.left",
                "default": "",
                "sanitize": "size-value"
            },
            "--hb-heading-pt": {
                "source": "supports.spacing.padding.top",
                "default": "",
                "sanitize": "size-value"
            },
            "--hb-heading-pr": {
                "source": "supports.spacing.padding.right",
                "default": "",
                "sanitize": "size-value"
            },
            "--hb-heading-pb": {
                "source": "supports.spacing.padding.bottom",
                "default": "",
                "sanitize": "size-value"
            },
            "--hb-heading-pl": {
                "source": "supports.spacing.padding.left",
                "default": "",
                "sanitize": "size-value"
            },
            "--hb-heading-lh": {
                "source": "supports.typography.lineHeight",
                "default": "",
                "sanitize": "size-token"
            },
            "--hb-text-align": {
                "source": "supports.typography.textAlign",
                "default": "",
                "sanitize": "text-align"
            },
            "--hb-text-align-v": {
                "source": "supports.typography.textAlignVertical",
                "default": "",
                "sanitize": "align-3"
            },
            "--hb-letter-spacing": {
                "source": "supports.typography.letterSpacing",
                "default": "",
                "sanitize": "length-signed"
            },
            "--hb-opacity": {
                "source": "supports.appearance.opacity",
                "default": "",
                "sanitize": "opacity"
            },
            "--hb-tx": {
                "source": "supports.position.x",
                "default": "",
                "sanitize": "length-signed"
            },
            "--hb-ty": {
                "source": "supports.position.y",
                "default": "",
                "sanitize": "length-signed"
            },
            "--hb-rotate": {
                "source": "supports.position.rotation",
                "default": "",
                "sanitize": "angle"
            },
            "--hb-shadow": {
                "source": "supports.effects.shadow",
                "default": "",
                "sanitize": "shadow"
            },
            "--hb-position-mode": {
                "source": "supports.position.mode",
                "default": "",
                "sanitize": "position-mode"
            }
        }
    },
    "render": {
        "template": {
            "tag": "h{{attributes.level}}",
            "class": "hb-block hb-block-heading {{attributes.extraClasses}}",
            "attributes": {
                "data-block-name": "{{name}}",
                "data-block-id": "{{id}}",
                "id": {
                    "value": "{{attributes.anchor}}",
                    "omitWhenEmpty": true
                },
                "title": {
                    "value": "{{attributes.titleAttr}}",
                    "omitWhenEmpty": true
                }
            },
            "children": [
                {
                    "type": "rich-text",
                    "attribute": "content",
                    "class": "hb-block-heading__text"
                }
            ]
        },
        "publicPartial": "blocks.heading",
        "script": null
    },
    "email": {
        "template": {
            "tag": "table",
            "attributes": {
                "role": "presentation",
                "cellpadding": "0",
                "cellspacing": "0",
                "border": "0",
                "width": "100%"
            },
            "children": [
                {
                    "tag": "tr",
                    "children": [
                        {
                            "tag": "td",
                            "attributes": {
                                "style": "padding: var(--hb-heading-mt, 0) var(--hb-heading-mr, 0) var(--hb-heading-mb, 12px) var(--hb-heading-ml, 0);"
                            },
                            "children": [
                                {
                                    "tag": "table",
                                    "attributes": {
                                        "role": "presentation",
                                        "cellpadding": "0",
                                        "cellspacing": "0",
                                        "border": "0",
                                        "width": "100%",
                                        "style": "width: var(--hb-heading-w, 100%); max-width: var(--hb-heading-maxw, 100%);"
                                    },
                                    "children": [
                                        {
                                            "tag": "tr",
                                            "children": [
                                                {
                                                    "tag": "td",
                                                    "attributes": {
                                                        "style": "padding: var(--hb-heading-pt, 0) var(--hb-heading-pr, 0) var(--hb-heading-pb, 0) var(--hb-heading-pl, 0); height: var(--hb-heading-h, auto); background-color: var(--hb-heading-bg, transparent); text-align: var(--hb-text-align, inherit);"
                                                    },
                                                    "children": [
                                                        {
                                                            "tag": "h{{attributes.level}}",
                                                            "attributes": {
                                                                "style": {
                                                                    "enumMap": "{{attributes.level}}",
                                                                    "cases": {
                                                                        "1": "margin:0; font-family: var(--hb-heading-ff, Arial, Helvetica, sans-serif); font-weight: var(--hb-heading-fw, 700); font-size: var(--hb-heading-fs, 32px); line-height: var(--hb-heading-lh, 1.3); letter-spacing: var(--hb-letter-spacing, normal); color: var(--hb-heading-color, #0a0a0a);",
                                                                        "2": "margin:0; font-family: var(--hb-heading-ff, Arial, Helvetica, sans-serif); font-weight: var(--hb-heading-fw, 700); font-size: var(--hb-heading-fs, 24px); line-height: var(--hb-heading-lh, 1.3); letter-spacing: var(--hb-letter-spacing, normal); color: var(--hb-heading-color, #0a0a0a);",
                                                                        "3": "margin:0; font-family: var(--hb-heading-ff, Arial, Helvetica, sans-serif); font-weight: var(--hb-heading-fw, 700); font-size: var(--hb-heading-fs, 20px); line-height: var(--hb-heading-lh, 1.3); letter-spacing: var(--hb-letter-spacing, normal); color: var(--hb-heading-color, #0a0a0a);",
                                                                        "4": "margin:0; font-family: var(--hb-heading-ff, Arial, Helvetica, sans-serif); font-weight: var(--hb-heading-fw, 700); font-size: var(--hb-heading-fs, 17px); line-height: var(--hb-heading-lh, 1.3); letter-spacing: var(--hb-letter-spacing, normal); color: var(--hb-heading-color, #0a0a0a);",
                                                                        "5": "margin:0; font-family: var(--hb-heading-ff, Arial, Helvetica, sans-serif); font-weight: var(--hb-heading-fw, 700); font-size: var(--hb-heading-fs, 16px); line-height: var(--hb-heading-lh, 1.3); letter-spacing: var(--hb-letter-spacing, normal); color: var(--hb-heading-color, #0a0a0a);",
                                                                        "6": "margin:0; font-family: var(--hb-heading-ff, Arial, Helvetica, sans-serif); font-weight: var(--hb-heading-fw, 700); font-size: var(--hb-heading-fs, 14px); line-height: var(--hb-heading-lh, 1.3); letter-spacing: var(--hb-letter-spacing, normal); color: var(--hb-heading-color, #0a0a0a);"
                                                                    },
                                                                    "default": "margin:0; font-family: var(--hb-heading-ff, Arial, Helvetica, sans-serif); font-weight: var(--hb-heading-fw, 700); font-size: var(--hb-heading-fs, 24px); line-height: var(--hb-heading-lh, 1.3); letter-spacing: var(--hb-letter-spacing, normal); color: var(--hb-heading-color, #0a0a0a);"
                                                                }
                                                            },
                                                            "children": [
                                                                {
                                                                    "type": "rich-text",
                                                                    "attribute": "content"
                                                                }
                                                            ]
                                                        }
                                                    ]
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        }
                    ]
                }
            ]
        }
    },
    "innerBlocks": {
        "enabled": false
    },
    "serialization": {
        "mode": "json",
        "saveAttributes": true,
        "saveSupports": true,
        "saveInnerBlocks": true,
        "migrations": []
    },
    "security": {
        "richText": "inline-basic",
        "allowRawHtml": false,
        "allowCustomCss": false
    }
}
