{
    "$schema": "../../../docs/block-schema.md",
    "apiVersion": 1,
    "name": "heisenberg/columns",
    "title": "heisenberg::blocks.columns.title",
    "category": "design",
    "icon": "columns",
    "description": "heisenberg::blocks.columns.description",
    "keywords": [
        "columns",
        "row",
        "layout",
        "grid",
        "container"
    ],
    "version": "1.0.0",
    "attributes": {
        "columns": {
            "type": "integer",
            "default": 2,
            "control": {
                "type": "number",
                "section": "settings",
                "min": 1,
                "max": 6
            }
        },
        "anchor": {
            "type": "string",
            "default": "",
            "sanitize": "text",
            "control": {
                "type": "text",
                "section": "general",
                "half": true,
                "placeholder": "unique-id"
            }
        },
        "titleAttr": {
            "type": "string",
            "default": "",
            "sanitize": "text",
            "translatable": true,
            "control": {
                "type": "text",
                "section": "general",
                "half": true,
                "placeholder": "Tooltip text"
            }
        },
        "extraClasses": {
            "type": "string",
            "default": "",
            "sanitize": "text",
            "control": {
                "type": "chips",
                "section": "general",
                "placeholder": "Add class…"
            }
        },
        "hideMobile": {
            "type": "boolean",
            "default": false,
            "sanitize": "boolean",
            "control": {
                "type": "toggle",
                "section": "visibility",
                "half": true
            }
        },
        "hideTablet": {
            "type": "boolean",
            "default": false,
            "sanitize": "boolean",
            "control": {
                "type": "toggle",
                "section": "visibility",
                "half": true
            }
        },
        "hideDesktop": {
            "type": "boolean",
            "default": false,
            "sanitize": "boolean",
            "control": {
                "type": "toggle",
                "section": "visibility",
                "half": true
            }
        },
        "fillWidth": {
            "type": "boolean",
            "default": false,
            "sanitize": "boolean",
            "control": false
        },
        "fillHeight": {
            "type": "boolean",
            "default": false,
            "sanitize": "boolean",
            "control": false
        },
        "hugWidth": {
            "type": "boolean",
            "default": false,
            "sanitize": "boolean",
            "control": false
        },
        "hugHeight": {
            "type": "boolean",
            "default": false,
            "sanitize": "boolean",
            "control": false
        },
        "clipContent": {
            "type": "boolean",
            "default": false,
            "sanitize": "boolean",
            "control": false
        }
    },
    "supports": {
        "align": [
            "left",
            "center",
            "right",
            "wide",
            "full"
        ],
        "layout": {
            "direction": true,
            "wrap": true,
            "justify": true,
            "align": true,
            "gap": true
        },
        "color": {
            "text": true,
            "background": true,
            "custom": false
        },
        "size": {
            "width": true,
            "height": true,
            "minWidth": true,
            "minHeight": true,
            "maxWidth": true,
            "maxHeight": true
        },
        "spacing": {
            "margin": {
                "top": true,
                "right": true,
                "bottom": true,
                "left": true
            },
            "padding": {
                "top": true,
                "right": true,
                "bottom": true,
                "left": true
            }
        },
        "border": {
            "width": {
                "top": true,
                "right": true,
                "bottom": true,
                "left": true
            },
            "style": true,
            "color": true,
            "radius": {
                "topLeft": true,
                "topRight": true,
                "bottomRight": true,
                "bottomLeft": true
            },
            "position": true
        },
        "animation": true,
        "states": {
            "hover": true,
            "active": true,
            "focus": true
        },
        "appearance": {
            "opacity": true
        },
        "effects": {
            "shadow": true,
            "filter": true,
            "backdrop": true
        }
    },
    "style": {
        "css": "./columns.css",
        "className": "hb-block-columns hb-supports hb-flex-layout",
        "classNames": [
            {
                "class": "hb-hide-mobile",
                "when": {
                    "attribute": "hideMobile",
                    "equals": true
                }
            },
            {
                "class": "hb-hide-tablet",
                "when": {
                    "attribute": "hideTablet",
                    "equals": true
                }
            },
            {
                "class": "hb-hide-desktop",
                "when": {
                    "attribute": "hideDesktop",
                    "equals": true
                }
            },
            {
                "class": "hb-size-fill-w",
                "when": {
                    "attribute": "fillWidth",
                    "equals": true
                }
            },
            {
                "class": "hb-size-fill-h",
                "when": {
                    "attribute": "fillHeight",
                    "equals": true
                }
            },
            {
                "class": "hb-size-hug-w",
                "when": {
                    "attribute": "hugWidth",
                    "equals": true
                }
            },
            {
                "class": "hb-size-hug-h",
                "when": {
                    "attribute": "hugHeight",
                    "equals": true
                }
            },
            {
                "class": "hb-size-clip",
                "when": {
                    "attribute": "clipContent",
                    "equals": true
                }
            }
        ],
        "variables": {
            "--hb-columns-color": {
                "source": "supports.color.text",
                "default": "",
                "sanitize": "color-value"
            },
            "--hb-columns-bg": {
                "source": "supports.color.background",
                "default": "",
                "sanitize": "color-value-or-gradient"
            },
            "--hb-columns-w": {
                "source": "supports.size.width",
                "default": "",
                "sanitize": "size-value"
            },
            "--hb-columns-h": {
                "source": "supports.size.height",
                "default": "",
                "sanitize": "size-value"
            },
            "--hb-columns-minw": {
                "source": "supports.size.minWidth",
                "default": "",
                "sanitize": "size-value"
            },
            "--hb-columns-minh": {
                "source": "supports.size.minHeight",
                "default": "",
                "sanitize": "size-value"
            },
            "--hb-columns-maxw": {
                "source": "supports.size.maxWidth",
                "default": "",
                "sanitize": "size-value"
            },
            "--hb-columns-maxh": {
                "source": "supports.size.maxHeight",
                "default": "",
                "sanitize": "size-value"
            },
            "--hb-columns-mt": {
                "source": "supports.spacing.margin.top",
                "default": "",
                "sanitize": "size-value"
            },
            "--hb-columns-mr": {
                "source": "supports.spacing.margin.right",
                "default": "",
                "sanitize": "size-value"
            },
            "--hb-columns-mb": {
                "source": "supports.spacing.margin.bottom",
                "default": "",
                "sanitize": "size-value"
            },
            "--hb-columns-ml": {
                "source": "supports.spacing.margin.left",
                "default": "",
                "sanitize": "size-value"
            },
            "--hb-columns-pt": {
                "source": "supports.spacing.padding.top",
                "default": "",
                "sanitize": "size-value"
            },
            "--hb-columns-pr": {
                "source": "supports.spacing.padding.right",
                "default": "",
                "sanitize": "size-value"
            },
            "--hb-columns-pb": {
                "source": "supports.spacing.padding.bottom",
                "default": "",
                "sanitize": "size-value"
            },
            "--hb-columns-pl": {
                "source": "supports.spacing.padding.left",
                "default": "",
                "sanitize": "size-value"
            },
            "--hb-border-top-width": {
                "source": "supports.border.width.top",
                "default": "",
                "sanitize": "size-value"
            },
            "--hb-border-right-width": {
                "source": "supports.border.width.right",
                "default": "",
                "sanitize": "size-value"
            },
            "--hb-border-bottom-width": {
                "source": "supports.border.width.bottom",
                "default": "",
                "sanitize": "size-value"
            },
            "--hb-border-left-width": {
                "source": "supports.border.width.left",
                "default": "",
                "sanitize": "size-value"
            },
            "--hb-border-top-style": {
                "source": "supports.border.style",
                "default": "solid",
                "sanitize": "border-style"
            },
            "--hb-border-right-style": {
                "source": "supports.border.style",
                "default": "solid",
                "sanitize": "border-style"
            },
            "--hb-border-bottom-style": {
                "source": "supports.border.style",
                "default": "solid",
                "sanitize": "border-style"
            },
            "--hb-border-left-style": {
                "source": "supports.border.style",
                "default": "solid",
                "sanitize": "border-style"
            },
            "--hb-border-top-color": {
                "source": "supports.border.color",
                "default": "",
                "sanitize": "color-value"
            },
            "--hb-border-right-color": {
                "source": "supports.border.color",
                "default": "",
                "sanitize": "color-value"
            },
            "--hb-border-bottom-color": {
                "source": "supports.border.color",
                "default": "",
                "sanitize": "color-value"
            },
            "--hb-border-left-color": {
                "source": "supports.border.color",
                "default": "",
                "sanitize": "color-value"
            },
            "--hb-border-radius-tl": {
                "source": "supports.border.radius.topLeft",
                "default": "",
                "sanitize": "size-value"
            },
            "--hb-border-radius-tr": {
                "source": "supports.border.radius.topRight",
                "default": "",
                "sanitize": "size-value"
            },
            "--hb-border-radius-br": {
                "source": "supports.border.radius.bottomRight",
                "default": "",
                "sanitize": "size-value"
            },
            "--hb-border-radius-bl": {
                "source": "supports.border.radius.bottomLeft",
                "default": "",
                "sanitize": "size-value"
            },
            "--hb-flex-justify": {
                "source": "supports.layout.justify",
                "default": "",
                "sanitize": "flex-justify"
            },
            "--hb-flex-align": {
                "source": "supports.layout.align",
                "default": "",
                "sanitize": "flex-align"
            },
            "--hb-flex-direction": {
                "source": "supports.layout.direction",
                "default": "row",
                "sanitize": "flex-direction"
            },
            "--hb-flex-wrap": {
                "source": "supports.layout.wrap",
                "default": "",
                "sanitize": "flex-wrap"
            },
            "--hb-flex-gap": {
                "source": "supports.layout.gap",
                "default": "",
                "sanitize": "size-value"
            },
            "--hb-opacity": {
                "source": "supports.appearance.opacity",
                "default": "",
                "sanitize": "opacity"
            },
            "--hb-box-sizing": {
                "source": "supports.border.position",
                "default": "",
                "sanitize": "box-sizing"
            },
            "--hb-shadow": {
                "source": "supports.effects.shadow",
                "default": "",
                "sanitize": "shadow"
            },
            "--hb-filter": {
                "source": "supports.effects.filter",
                "default": "",
                "sanitize": "filter"
            },
            "--hb-backdrop": {
                "source": "supports.effects.backdrop",
                "default": "",
                "sanitize": "filter"
            }
        }
    },
    "render": {
        "template": {
            "tag": "div",
            "class": "hb-block hb-block-columns {{attributes.extraClasses}}",
            "attributes": {
                "data-block-name": "{{name}}",
                "data-block-id": "{{id}}",
                "id": {
                    "value": "{{attributes.anchor}}",
                    "omitWhenEmpty": true
                },
                "title": {
                    "value": "{{attributes.titleAttr}}",
                    "omitWhenEmpty": true
                }
            },
            "children": [
                {
                    "type": "inner-blocks"
                }
            ]
        },
        "publicPartial": "blocks.columns",
        "script": null
    },
    "email": {
        "template": {
            "tag": "table",
            "attributes": {
                "role": "presentation",
                "cellpadding": "0",
                "cellspacing": "0",
                "border": "0",
                "width": "100%"
            },
            "children": [
                {
                    "tag": "tr",
                    "children": [
                        {
                            "tag": "td",
                            "attributes": {
                                "align": {
                                    "enumMap": "{{supports.align}}",
                                    "cases": {
                                        "left": "left",
                                        "center": "center",
                                        "right": "right"
                                    },
                                    "default": "left"
                                },
                                "style": "padding: var(--hb-columns-mt, 0) var(--hb-columns-mr, 0) var(--hb-columns-mb, 0) var(--hb-columns-ml, 0);"
                            },
                            "children": [
                                {
                                    "tag": "table",
                                    "attributes": {
                                        "role": "presentation",
                                        "cellpadding": "0",
                                        "cellspacing": "0",
                                        "border": "0",
                                        "width": "100%",
                                        "style": "width: var(--hb-columns-w, 100%); max-width: var(--hb-columns-maxw, 100%);"
                                    },
                                    "children": [
                                        {
                                            "tag": "tr",
                                            "children": [
                                                {
                                                    "tag": "td",
                                                    "attributes": {
                                                        "style": "padding: var(--hb-columns-pt, 0) var(--hb-columns-pr, 0) var(--hb-columns-pb, 0) var(--hb-columns-pl, 0); height: var(--hb-columns-h, auto); background-color: var(--hb-columns-bg, transparent); color: var(--hb-columns-color, inherit); border-top: var(--hb-border-top-width, 0) var(--hb-border-top-style, solid) var(--hb-border-top-color, transparent); border-right: var(--hb-border-right-width, 0) var(--hb-border-right-style, solid) var(--hb-border-right-color, transparent); border-bottom: var(--hb-border-bottom-width, 0) var(--hb-border-bottom-style, solid) var(--hb-border-bottom-color, transparent); border-left: var(--hb-border-left-width, 0) var(--hb-border-left-style, solid) var(--hb-border-left-color, transparent); border-radius: var(--hb-border-radius-tl, 0) var(--hb-border-radius-tr, 0) var(--hb-border-radius-br, 0) var(--hb-border-radius-bl, 0);"
                                                    },
                                                    "children": [
                                                        {
                                                            "tag": "table",
                                                            "attributes": {
                                                                "role": "presentation",
                                                                "cellpadding": "0",
                                                                "cellspacing": "0",
                                                                "border": "0",
                                                                "width": "100%"
                                                            },
                                                            "children": [
                                                                {
                                                                    "type": "inner-blocks",
                                                                    "flow": "cells"
                                                                }
                                                            ]
                                                        }
                                                    ]
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        }
                    ]
                }
            ]
        }
    },
    "innerBlocks": {
        "enabled": true,
        "allowedBlocks": [
            "heisenberg/column"
        ],
        "orientation": "horizontal",
        "template": [
            [
                "heisenberg/column"
            ],
            [
                "heisenberg/column"
            ]
        ],
        "appender": "button"
    },
    "serialization": {
        "mode": "json",
        "saveAttributes": true,
        "saveSupports": true,
        "saveInnerBlocks": true,
        "migrations": []
    },
    "security": {
        "richText": "none",
        "allowRawHtml": false,
        "allowCustomCss": false
    }
}
